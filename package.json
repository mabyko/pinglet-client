    "dev": "tsc --watch",
    "prepare": "npm run build",
    "postinstall": "node dist/postinstall.js || exit 0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
